    "react-dom": "19.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "zod": "^3.25.76",
    "stripe": "^22.6.0",
    "@react-pdf/renderer": "^4.3.0",
    "qrcode": "^1.5.4",
    "pdf-lib": "^1.17.1",
    "fflate": "^0.8.2",
    "tesseract.js": "^7.0.0",
    "unpdf": "^0.12.1"
  },
