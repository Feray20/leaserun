# LeaseRun – Umgebungsvariablen (Vorlage, KEINE echten Werte eintragen und nie committen).
# Produktion/Preview: in Vercel → Project → Settings → Environment Variables pflegen.

# --- Supabase (nur serverseitig; der Service-Schlüssel darf nie in den Browser) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Website / Betrieb ---
PUBLIC_SITE_URL=https://leaserun.com
ADMIN_EMAILS=
ADMIN_MFA=
ADMIN_IP_ALLOWLIST=
CRON_SECRET=
AUDIT_HASH_SALT=
ANALYTICS_SECRET=
NEWSLETTER_SECRET=
LEAD_TOKEN_SECRET=
B2B_SELF_SIGNUP=
B2B_NOTIFY_EMAIL=

# --- LeaseRun API v1 ---
# Pfeffer für die API-Schlüssel-Hashes (mind. 32 Zeichen, z. B. `openssl rand -base64 48`).
# Achtung: Eine Änderung macht alle bestehenden API-Schlüssel ungültig.
API_KEY_PEPPER=
# 32 Byte als 64 Hex-Zeichen (`openssl rand -hex 32`) – verschlüsselt die Webhook-Geheimnisse (AES-256-GCM). Nie löschen.
API_ENCRYPTION_KEY=
# Optional: öffentliche Basis-URL (Standard: ${PUBLIC_SITE_URL}/api/v1). api.leaserun.com erst nach Einrichtung der Domain setzen.
API_BASE_URL=
# Optional: Virenscanner (POST application/octet-stream → JSON { "clean": true|false }).
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# --- Zahlungen (Stripe) ---
BILLING_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ISSUING_WEBHOOK_SECRET=

# --- E-Mail ---
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
CANCEL_FROM_EMAIL=
CANCEL_TO_EMAIL=

# --- Rechnungen / Steuer ---
INVOICE_IBAN=
INVOICE_BIC=
INVOICE_BANK_NAME=
INVOICE_ACCOUNT_HOLDER=
TAX_ADVISOR_EMAIL=
TAX_SKR=
TAX_DISPATCH_WORKDAY=

# --- Creator Hub ---
CREATOR_PII_KEY=
CREATOR_PII_KEY_OLD=
CREATOR_PAYOUT_IBAN=
CREATOR_PAYOUT_BIC=
CREATOR_PAYOUT_ACCOUNT_HOLDER=
CREATOR_COUNT_TEST_PAYMENTS=

# --- LeaseRun Card (in Vorbereitung) ---
CARD_PROVIDER=
CARD_PROVIDER_WEBHOOK_SECRET=

# --- Sonstiges ---
GOOGLE_PLACES_API_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
